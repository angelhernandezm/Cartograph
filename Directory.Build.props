<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Shipped packages carry an XML documentation file: it drives IntelliSense for consumers and
      NuGet package analysis flags its absence. Projects that produce no package turn this off
      individually, because TreatWarningsAsErrors would otherwise promote every undocumented public
      test or sample class into a build failure for no benefit.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <Product>Cartograph</Product>
    <Authors>Angel Hernandez</Authors>
    <Company>Angel Hernandez</Company>
    <Copyright>Copyright (c) 2026 Angel Hernandez</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/angelhernandezm/Cartograph</PackageProjectUrl>
    <RepositoryUrl>https://github.com/angelhernandezm/Cartograph</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Version>0.1.0-alpha</Version>
  </PropertyGroup>

  <!--
    Packaging defaults shared by every shipped package. Symbols travel as a separate .snupkg so the
    main package stays small, and Source Link (built into the .NET SDK for GitHub-hosted repos)
    turns the embedded commit metadata into a debuggable source mapping.
  -->
  <PropertyGroup>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!--
    A deterministic build needs the source root normalized away, which only the CI build knows how to
    do safely. Setting it unconditionally would break F5 debugging of a local build.
  -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    Each package carries its own landing page. The root README is written for someone browsing the
    repository - build steps, layout, benchmarks - whereas a package page has to answer "what is this
    and how do I call it" for someone who has just found it on nuget.org. PACKAGE.md lives beside the
    project it describes and is attached only to projects that actually produce a package, because
    NuGet fails the pack when PackageReadmeFile names a file the package does not contain.
  -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildProjectDirectory)\PACKAGE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
