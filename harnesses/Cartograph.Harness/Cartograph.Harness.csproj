<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AssemblyName>cartograph-harness</AssemblyName>
    <RootNamespace>Cartograph.Harness</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cartograph\Cartograph.csproj" />
    <ProjectReference Include="..\..\src\Cartograph.Catalog\Cartograph.Catalog.csproj" />
    <ProjectReference Include="..\..\src\Cartograph.Format\Cartograph.Format.csproj" />
  </ItemGroup>

</Project>
