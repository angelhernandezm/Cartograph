<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Cartograph.Catalog</PackageId>
    <Description>File-catalog convention for Cartograph artifacts: a self-describing manifest stored as record zero that maps packed file names, sizes and timestamps back to the segments and records holding them, plus a read-only facade for extracting and verifying any catalogued file.</Description>
    <PackageTags>memory-mapped;artifact;catalog;manifest;archive;zero-copy</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cartograph\Cartograph.csproj" />
    <ProjectReference Include="..\Cartograph.Format\Cartograph.Format.csproj" />
  </ItemGroup>

</Project>
